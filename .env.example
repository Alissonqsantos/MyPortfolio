# Painéis-satélite do hero (src/al/satelites.js) — layout aleatório por
# sessão atrás do Al. Copie para `.env` p/ ajustar.
# Tudo opcional: sem `.env`, valem os padrões abaixo. Requer restart do `npm run dev`.
VITE_SATS_VISIVEL=true    # false = some com os painéis
VITE_SATS_SEED=           # layout fixo p/ debug (vazio = seed da sessão)
VITE_SATS_TAM=1           # × tamanho dos painéis
VITE_SATS_RAIO=0.09       # arredondamento dos cantos (unidades)
VITE_SATS_ESPESSURA=0.035 # espessura da laje (unidades)
VITE_SATS_TOMBO=1         # × velocidade do tombo (0 = parados, 2 = dobro)
VITE_SATS_DERIVA=1        # × amplitude da deriva (0 = fixos nas bases)
VITE_SATS_BRILHO=0.22     # auto-iluminação da imagem (0 = apagado)

# Luz branca sobre o Al (src/al/geometry.js → configLuzBranca).
# Multiplicador das 3 brancas + reflexo do ambiente nas letras.
# 1 = valores do CONFIG; 0 = brancas apagadas (só o roxo do buraco);
# 2 = dobro. Tudo opcional: sem a linha, vale 1. Requer restart do `npm run dev`.
VITE_LUZ_BRANCA=1         # × intensidade da luz branca sobre o Al
